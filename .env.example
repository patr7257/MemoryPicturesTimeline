# Neon Postgres (pooled connection string, TCP via pg Pool)
DATABASE_URL=

# Better Auth
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the app. Prod: https://memories.patrickrobel.dk
# Dev: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# WebAuthn passkeys. Prod: rpID patrickrobel.dk, origin https://memories.patrickrobel.dk
# Dev: rpID localhost, origin http://localhost:3000
PASSKEY_RP_ID=localhost
PASSKEY_ORIGIN=http://localhost:3000

# Comma-separated family email allowlist; only these can register/sign in.
FAMILY_EMAILS=

# ZeptoMail HTTPS Email API (raw token, code adds the Zoho-enczapikey prefix).
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_FROM=
# Default https://api.zeptomail.eu/v1.1 (EU DC)
ZEPTOMAIL_BASE_URL=

# Cloudflare R2 (S3-compatible), private bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
